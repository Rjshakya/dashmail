{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/app.ts",
  "compatibility_date": "2025-12-13",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "12",
      "localConnectionString": "postgresql://postgres:password@localhost:5432/postgres",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "dashmail",
      "binding": "DASHMAILBUCKET",
      "remote": true,
    },
  ],
  "workflows": [
    // {
    // 	"binding": "SYNC_AND_WATCH_MAIL_INBOX_WORKFLOW",
    // 	"class_name": "SyncAndWatchInboxMailsFlow",
    // 	"name": "sync-and-watch-inbox-mail",
    // },
    {
      "binding": "GenerateMailReportWorkflow",
      "class_name": "GenerateMailReportWorkflow",
      "name": "generate_mail_report_workflow",
    },
    {
      "binding": "MailScheduleWorkflow",
      "class_name": "MailScheduleWorkflow",
      "name": "mail_schedule_workflow",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Threads",
        "class_name": "Threads",
      },
      {
        "name": "MailInbox",
        "class_name": "MailInbox",
      },
      {
        "name": "GmailAgent",
        "class_name": "GmailAgent"
      }
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Threads", "MailInbox" , "GmailAgent"],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "MAIL_INBOX_KV",
      "id": "7b0eeaf5827a4b219c4524602b552834",
    },
  ],
  "queues": {
    "consumers": [
      { "queue": "email-queue", "max_batch_size": 90, "max_batch_timeout": 2 },
    ],
    "producers": [
      {
        "queue": "email-queue",
        "binding": "EMAIL_QUEUE",
      },
    ],
  },
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
